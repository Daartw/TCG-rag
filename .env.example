# API key del proveedor de LLM usado para la etapa de generación.
# Por defecto se usa Groq (gratuito, sin tarjeta). Generarla en https://console.groq.com/keys
GROQ_API_KEY=tu_api_key_aqui

# Alternativa: descomentar y usar Anthropic (ver bloque comentado en src/llm_client.py)
# ANTHROPIC_API_KEY=tu_api_key_aqui

# Identificador del set en la API de Pokemon TCG (Evolving Skies = swsh7)
POKEMON_SET_ID=swsh7

# Ruta local donde se persiste la base de datos vectorial
CHROMA_PERSIST_DIR=data/chroma_db
